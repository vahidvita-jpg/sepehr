<Window x:Class="Sepehr.Desktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سپهر - مدیریت مدرسه" Width="1100" Height="700" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" FontFamily="Tahoma" FontSize="14"
        Background="{StaticResource Surface}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (right side in RTL) -->
        <Border Grid.Column="0" Background="{StaticResource Primary}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,16">
                    <TextBlock Text="سپهر" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="SchoolNameText" Foreground="#CFE0F1" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <TextBlock x:Name="UserText" Foreground="#CFE0F1" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="NavDashboard" Content="داشبورد" Style="{StaticResource NavButton}" Click="NavDashboard_Click" ToolTip="نمایش وضعیت زنگ و تاریخ"/>
                    <Button x:Name="NavTeachers" Content="معلمان" Style="{StaticResource NavButton}" Click="NavTeachers_Click" ToolTip="مدیریت معلمان"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="16">
            <!-- Dashboard -->
            <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="WeekdayText" FontSize="18" Foreground="#555"/>
                            <TextBlock x:Name="PersianDateText" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
                            <TextBlock x:Name="GregorianText" FontSize="14" Foreground="#777" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="ClockText" FontSize="40" FontWeight="Bold" Margin="0,8,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="زنگ جاری" Foreground="#777"/>
                                <TextBlock x:Name="CurrentTitle" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CurrentDetail" Foreground="#555" Margin="0,4,0,0"/>
                                <TextBlock x:Name="RemainingText" FontSize="20" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="کلاس بعدی (زنگ بعدی)" Foreground="#777"/>
                                <TextBlock x:Name="NextTitle" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="NextDetail" Foreground="#555" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="نمایش نام معلم، کلاس و درس جاری پس از ثبت جدول هفتگی اضافه می‌شود." Foreground="#888" Margin="12,6"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Teachers -->
            <Grid x:Name="TeachersPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="افزودن معلم" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                        <UniformGrid Columns="5">
                            <StackPanel Margin="4"><TextBlock Text="نام"/><TextBox x:Name="TFirst" Padding="5"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="نام خانوادگی"/><TextBox x:Name="TLast" Padding="5"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="کد ملی"/><TextBox x:Name="TNational" Padding="5" FlowDirection="LeftToRight"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="کد پرسنلی"/><TextBox x:Name="TEmployee" Padding="5" FlowDirection="LeftToRight"/></StackPanel>
                            <StackPanel Margin="4"><TextBlock Text="موبایل"/><TextBox x:Name="TMobile" Padding="5" FlowDirection="LeftToRight"/></StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="TError" Foreground="#C00000" Margin="4,6,0,0" TextWrapping="Wrap"/>
                        <Button Content="افزودن" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="4,8,4,0" Click="AddTeacher_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DataGrid x:Name="TeachersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام و نام خانوادگی" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="کد ملی" Binding="{Binding NationalId}" Width="*"/>
                            <DataGridTextColumn Header="کد پرسنلی" Binding="{Binding EmployeeId}" Width="*"/>
                            <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="*"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
