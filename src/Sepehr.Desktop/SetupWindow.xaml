<Window x:Class="Sepehr.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="راه‌اندازی اولیه - سپهر" Width="520" Height="640" WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft" FontFamily="Tahoma" FontSize="14" Background="{StaticResource Surface}" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="نرم‌افزار جامع و هوشمند مدیریت مدرسه سپهر" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Primary}" TextWrapping="Wrap"/>
            <TextBlock Text="برای شروع، اطلاعات مدرسه و حساب مدیر را وارد کنید." Margin="0,6,0,18" Foreground="#555"/>

            <TextBlock Text="نام مدرسه"/>
            <TextBox x:Name="SchoolBox" Text="آموزشگاه میرزا کوچک‌خان" Padding="6" Margin="0,4,0,12"/>
            <TextBlock Text="نام مدیر مدرسه"/>
            <TextBox x:Name="PrincipalBox" Padding="6" Margin="0,4,0,12"/>
            <TextBlock Text="سال تحصیلی (مثال: 1405-1406)"/>
            <TextBox x:Name="YearBox" Padding="6" Margin="0,4,0,12" FlowDirection="LeftToRight"/>

            <Separator Margin="0,6,0,12"/>
            <TextBlock Text="حساب مدیر سیستم" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="نام نمایشی"/>
            <TextBox x:Name="DisplayBox" Padding="6" Margin="0,4,0,12"/>
            <TextBlock Text="نام کاربری (انگلیسی)"/>
            <TextBox x:Name="UserBox" Padding="6" Margin="0,4,0,12" FlowDirection="LeftToRight"/>
            <TextBlock Text="رمز عبور (حداقل ۸ نویسه)"/>
            <PasswordBox x:Name="PassBox" Padding="6" Margin="0,4,0,12"/>
            <TextBlock Text="تکرار رمز عبور"/>
            <PasswordBox x:Name="Pass2Box" Padding="6" Margin="0,4,0,12"/>

            <TextBlock x:Name="ErrorText" Foreground="#C00000" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Button Content="ایجاد و شروع" Style="{StaticResource PrimaryButton}" Click="Create_Click" IsDefault="True"/>
        </StackPanel>
    </ScrollViewer>
</Window>
